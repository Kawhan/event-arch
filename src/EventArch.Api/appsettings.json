{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=eventarch;Username=eventarch;Password=eventarch",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 50
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Properties": {
      "Application": "EventArch.Api"
    }
  },
  "AllowedHosts": "*"
}
