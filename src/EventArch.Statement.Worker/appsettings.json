{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=eventarch;Username=eventarch;Password=eventarch",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Rebus": {
    "QueueName": "eventarch.statement"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Rebus": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Properties": {
      "Application": "EventArch.Statement.Worker"
    }
  }
}
